{
  "name": "@bundle-stats/utils",
  "version": "4.22.3",
  "description": "BundleStats utils",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./lib/types/webpack/index.d.ts",
        "default": "./lib/webpack.mjs"
      },
      "require": {
        "types": "./lib/types/webpack/index.d.ts",
        "default": "./lib/webpack.cjs"
      }
    },
    "./browsertime": {
      "import": {
        "types": "./lib/types/browsertime/index.d.ts",
        "default": "./lib/browsertime.mjs"
      },
      "require": {
        "types": "./lib/types/browsertime/index.d.ts",
        "default": "./lib/browsertime.cjs"
      }
    },
    "./lighthouse": {
      "import": {
        "types": "./lib/types/lighthouse/index.d.ts",
        "default": "./lib/lighthouse.mjs"
      },
      "require": {
        "types": "./lib/types/lighthouse/index.d.ts",
        "default": "./lib/lighthouse.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">= 22.0"
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "npm run clean && tsdown && npm run build-types",
    "build-types": "tsc --project tsconfig.types.json",
    "clean": "rimraf ./lib",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run src"
  },
  "keywords": [],
  "author": {
    "name": "Viorel Cojocaru",
    "email": "vio@relative-ci.com",
    "url": "https://relative-ci.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relative-ci/bundle-stats.git"
  },
  "bugs": {
    "url": "https://github.com/relative-ci/bundle-stats/issues"
  },
  "homepage": "https://github.com/relative-ci/bundle-stats/blob/master/packages/utils#readme",
  "dependencies": {
    "@bundle-stats/plugin-webpack-filter": "^4.22.3",
    "@bundle-stats/plugin-webpack-validate": "^4.22.3",
    "serialize-query-params": "2.0.4"
  },
  "devDependencies": {
    "@types/lodash": "4.17.25",
    "jest-date-mock": "1.0.10",
    "lodash": "4.18.1",
    "regenerator-runtime": "0.14.1",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "lodash": "^4.0.0"
  }
}
