{
  "name": "@bundle-stats/plugin-webpack-validate",
  "version": "4.22.3",
  "description": "BundleStats webpack validate plugin",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">= 22.0"
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "npm run clean && tsdown",
    "clean": "rimraf ./lib",
    "lint": "eslint .",
    "test": "TZ=UTC jest src --maxWorkers=4"
  },
  "keywords": [],
  "author": {
    "name": "Viorel Cojocaru",
    "email": "vio@relative-ci.com",
    "url": "https://relative-ci.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relative-ci/bundle-stats.git"
  },
  "bugs": {
    "url": "https://github.com/relative-ci/bundle-stats/issues"
  },
  "homepage": "https://github.com/relative-ci/bundle-stats/blob/master/packages/plugin-webpack-filter#readme",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "jest": "30.4.2",
    "jest-cli": "30.4.2",
    "jest-date-mock": "1.0.10",
    "regenerator-runtime": "0.14.1",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "lodash": "4.18.1",
    "superstruct": "2.0.2",
    "tslib": "2.8.1"
  }
}
