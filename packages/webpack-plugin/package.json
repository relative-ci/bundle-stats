{
  "name": "bundle-stats-webpack-plugin",
  "version": "4.22.3",
  "description": "In-depth bundle analyzer for webpack(bundle size, assets, modules, packages)",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./typings.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./typings.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./typings.d.ts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "lib": "lib"
  },
  "engines": {
    "node": ">= 22.0"
  },
  "scripts": {
    "build": "npm run clean && tsdown",
    "clean": "rimraf ./lib",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run src",
    "test:package": "cd test/package && npm install --force && npm test --"
  },
  "keywords": [
    "webpack",
    "webpack-plugin",
    "bundle-size",
    "bundle-analyzer",
    "bundle-stats",
    "stats",
    "bundle",
    "size",
    "assets",
    "chunks",
    "modules"
  ],
  "author": {
    "name": "Viorel Cojocaru",
    "email": "vio@relative-ci.com",
    "url": "https://relative-ci.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relative-ci/bundle-stats.git"
  },
  "bugs": {
    "url": "https://github.com/relative-ci/bundle-stats/issues"
  },
  "homepage": "https://github.com/relative-ci/bundle-stats/blob/master/packages/webpack-plugin#readme",
  "dependencies": {
    "@bundle-stats/cli-utils": "^4.22.3",
    "@bundle-stats/plugin-webpack-validate": "^4.22.3",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "core-js": "^3.50.0",
    "jest-date-mock": "1.0.10",
    "memory-fs": "0.5.0",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "vitest": "4.1.11",
    "webpack": "^5.108.1"
  },
  "peerDependencies": {
    "@rspack/core": "0.x || 1.x",
    "webpack": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
